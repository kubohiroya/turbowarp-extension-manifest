{
  "name": "@kubohiroya/turbowarp-extension-manifest",
  "version": "0.7.0",
  "description": "Reusable manifest contract utilities extracted from turbowarp-extension-template.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/kubohiroya/turbowarp-extension-manifest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-extension-manifest.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-extension-manifest/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./resource-declaration.schema.json": "./schemas/resource-declaration.schema.json",
    "./distribution": {
      "types": "./dist/distribution.d.ts",
      "import": "./dist/distribution.js",
      "default": "./dist/distribution.js"
    },
    "./extension-package.schema.json": "./schemas/extension-package.schema.json",
    "./build-profile": {
      "types": "./dist/build-profile.d.ts",
      "import": "./dist/build-profile.js",
      "default": "./dist/build-profile.js"
    },
    "./extension-build.schema.json": "./schemas/extension-build.schema.json"
  },
  "files": [
    "dist/",
    "schemas/",
    "src/",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json",
    "pack:check": "pnpm pack --dry-run",
    "release:check": "npm publish --dry-run --access public",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run pack:check"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "ajv": "8.20.0"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "manifest",
    "template"
  ],
  "gitHead": "c753096b2c03fd1be4c20bc3f64f8b8fb2ebc77d",
  "x-turbowarp-source": {
    "revision": "c753096b2c03fd1be4c20bc3f64f8b8fb2ebc77d",
    "revisionRole": "base-commit",
    "sourceState": "working-tree-release-overlay"
  }
}
